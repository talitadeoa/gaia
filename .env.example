# Copie para ~/.config/gaia/.env (ou exporte no shell).
# NUNCA versione este arquivo com valores reais.

# --- Agente (modelo) ---
# Trocar de provedor/modelo no meio da conversa: rode /modelo (lista ao vivo +
# escolha numerada) ou /modelo provider/model. A escolha é salva no config.toml.
#
# Presets embutidos (basta a chave; base_url padrão já configurado):
#   deepseek   -> DEEPSEEK_API_KEY
#   openai     -> OPENAI_API_KEY
#   openrouter -> OPENROUTER_API_KEY
#   anthropic  -> ANTHROPIC_API_KEY  (o provedor "claude" é alias)
#   ollama     -> sem chave (http://127.0.0.1:11434/v1)
#   commandcode           -> COMMAND_CODE_API_KEY  (lê ~/.commandcode/auth.json)
#   commandcode-anthropic -> mesma chave, wire Anthropic (modelos Claude)
#   opendesign            -> OPENDESIGN_API_KEY    (lê ~/.pi/agent/auth.json)
#   opencode              -> OPENCODE_API_KEY      (OpenCode Zen)
#   groq                   -> GROQ_API_KEY
#   mistral                -> MISTRAL_API_KEY
#   xai                    -> XAI_API_KEY          (alias: grok)
#   custom                 -> use GAIA_AGENT_BASE_URL e GAIA_AGENT_API_KEY
#
# A Command Code pega a chave do `cmd` CLI automaticamente (~/.commandcode/
# auth.json): costuma bastar `provider = "commandcode"` sem colar chave.
# Requer plano com acesso à Provider API (Go não inclui; 403 upgrade_required).
#
# Padrao: Command Code (deepseek V4.1 Flash). A chave usada e sempre a do
# provedor escolhido; a chave dos outros fica ignorada.
# GAIA_AGENT_PROVIDER=commandcode
# GAIA_AGENT_MODEL=deepseek/deepseek-v4.1-flash
# Endpoint custom (vazio = endpoint padrao do provedor):
# GAIA_AGENT_BASE_URL=
# Chave da API (ou a nativa do provedor: COMMAND_CODE_API_KEY,
# DEEPSEEK_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY...):
# GAIA_AGENT_API_KEY=
# Chaves por provedor (usadas quando GAIA_AGENT_API_KEY está vazio):
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# COMMAND_CODE_API_KEY=
# OPENDESIGN_API_KEY=
# OPENCODE_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# XAI_API_KEY=
# Diretorio de trabalho do agente (vazio = diretorio atual):
# GAIA_AGENT_DIRECTORY=/caminho/do/projeto
# Limites do turno:
# GAIA_AGENT_MAX_TOKENS=4096
# GAIA_AGENT_TEMPERATURE=0.3
# GAIA_AGENT_MAX_STEPS=32
# GAIA_AGENT_REQUEST_TIMEOUT=900
# GAIA_AGENT_STALL_TIMEOUT=90
# Retomar a sessao salva ao abrir:
# GAIA_AGENT_RESUME_SESSION=true
# Ferramentas (leitura, escrita, shell):
# GAIA_AGENT_TOOLS=true
# Permitir acesso fora do diretorio do projeto:
# GAIA_AGENT_ALLOW_OUTSIDE_PROJECT=true
# Economia de tokens:
# Modelo pequeno para pedidos curtos (vazio = sempre o principal):
# So vale dentro do provedor atual (id de outro provedor e descartado):
# GAIA_AGENT_FAST_MODEL=deepseek/deepseek-v4.1-flash-fast
# Cachear persona + preferencias (Anthropic):
# GAIA_AGENT_CACHE_PROMPT=true
# Depois disso o historico antigo vira um resumo:
# GAIA_AGENT_MAX_HISTORY_MESSAGES=20
# GAIA_AGENT_MAX_HISTORY_CHARS=24000
# GAIA_AGENT_SUMMARY_CHARS=1200
# Medir tokens por turno (aparece no /status):
# GAIA_AGENT_USAGE=true
# Teto de resultado de ferramenta guardado no histórico (0 = sem teto):
# GAIA_AGENT_TOOL_RESULT_CHARS=4000
# Resumo do histórico: local (extrativo) | llm (semântico, com fallback local):
# GAIA_AGENT_HISTORY_SUMMARY=local
# Modelo do resumo (vazio = modelo principal):
# GAIA_AGENT_HISTORY_SUMMARY_MODEL=

# --- Voz ---
# GAIA_TTS_PROVIDER=edge   # edge | say | none
# GAIA_TTS_VOICE=pt-BR-FranciscaNeural
# GAIA_STT_MODEL=small
# --- Audiobook (PDF/texto -> MP3) ---
# GAIA_AUDIOBOOK_VOICE=pt-BR-ThalitaNeural
# GAIA_AUDIOBOOK_INBOX=            # vazio => <data_dir>/audiobooks/inbox
# GAIA_AUDIOBOOK_WATCH_MINUTES=0   # >0 = confere a pasta sozinho
# GAIA_STT_LANGUAGE=pt
# GAIA_STT_CONFIRM_TRANSCRIPT=false
# Legendas parciais ao vivo:
# GAIA_STT_PARTIAL_TRANSCRIPTION=true
# GAIA_STT_PARTIAL_INTERVAL_SECONDS=1.5
# GAIA_STT_PARTIAL_WINDOW_SECONDS=10
# GAIA_AUDIO_INPUT_DEVICE=
# Escuta continua: microfone aberto; fala -> executa -> responde -> volta a ouvir.
# GAIA_AUDIO_CONTINUOUS=true
# Pausa que encerra uma fala (em ms; 5000 = 5s):
# GAIA_AUDIO_SILENCE_MS=5000
# Confiança mínima do VAD (0..1) para considerar que há fala (0.5 = padrão):
# GAIA_AUDIO_VAD_THRESHOLD=0.5
# 0 = sem limite para uma fala:
# GAIA_AUDIO_MAX_SECONDS=0
# Silêncio (em segundos) que desliga o microfone automaticamente (0 = nunca):
# GAIA_AUDIO_AUTO_MUTE_SECONDS=30
# Mostrar raciocínio e diffs no terminal:
# GAIA_UI_SHOW_REASONING=true
# GAIA_UI_SHOW_DIFFS=true
# Painéis de metas e lua começam recolhidos:
# GAIA_UI_DASHBOARD_COLLAPSED=true
# Idioma do eco de tradução (chinês, inglês ou francês):
# GAIA_ECHO_LANGUAGE=zh

# --- Second Brain ---
# GAIA_SECOND_BRAIN_PATH=~/SecondBrain
# GAIA_SECOND_BRAIN_INDEX=
# GAIA_SB_EMBED_API_KEY=
# GAIA_SB_EMBED_MODEL=
# GAIA_SB_EMBED_BASE_URL=
# GAIA_SB_PREFERENCES_FILE=~/SecondBrain/preferences.md
# GAIA_SB_AUTO_CONTEXT=true
# GAIA_SB_CONTEXT_RESULTS=2
# GAIA_SB_CONTEXT_CHARS=480
# GAIA_SB_CONTEXT_MAX_CHARS=1200
# Criar nota nao pergunta por padrao; editar/excluir continuam pedindo.
# GAIA_SB_CONFIRM_CREATE=false
# GAIA_SB_REQUIRE_CONFIRMATION=true
# Reindexar a cada inicio (pode ser lento em bases grandes):
# GAIA_SB_REINDEX_ON_START=false
# Extensoes indexadas como texto puro (lista, so no TOML: text_extensions).
# .docx e .pdf exigiriam biblioteca nova e ficam de fora.
# [secondbrain] text_extensions = [".md", ".tex", ".bib"]

# --- Agente: permissoes ---
# Auto-aprovar ferramentas do agente (PERIGOSO; padrao false).
# GAIA_AGENT_AUTO_APPROVE=false

# --- Memoria diaria ---
# Consolida o dia numa nota do Second Brain (23:00, ao sair e catch-up).
# GAIA_MEMORY_ENABLED=true
# GAIA_MEMORY_AT=23:00
# GAIA_MEMORY_ON_EXIT=true
# GAIA_MEMORY_USE_LLM=true
# GAIA_MEMORY_FOLDER=Memoria
# GAIA_MEMORY_DREAM_ENABLED=true
# GAIA_MEMORY_DREAM_AT=02:00
# GAIA_MEMORY_DREAM_UNTIL=08:00
# GAIA_MEMORY_DREAM_FOLDER=Sonhos
# GAIA_MEMORY_DREAM_NOTIFY=true
# GAIA_MEMORY_DREAM_NOTIFY_AT=08:00
# GAIA_MEMORY_RETRY_MINUTES=10

# --- Briefing diario (Telegram) ---
# Manha e meio-dia sem LLM; o fecho da noite usa o modelo para o insight.
# Manha: tarefas do dia (sem rotinas). Meio-dia: feito/pendente (sem rotinas).
# Fecho da noite: feito/nao feito + rotina matinal + insight.
# GAIA_BRIEFING_ENABLED=true
# GAIA_BRIEFING_MORNING_AT=08:00
# GAIA_BRIEFING_NOON_AT=12:00
# GAIA_BRIEFING_NOON_UNTIL=18:00
# GAIA_BRIEFING_MORNING_ROUTINE=matinal   # usada no fecho da noite
# GAIA_BRIEFING_MAX_TASKS=15
# Fecho da noite (18:00-23:00). evening_insight chama o modelo:
# GAIA_BRIEFING_EVENING_ENABLED=true
# GAIA_BRIEFING_EVENING_AT=18:00
# GAIA_BRIEFING_EVENING_UNTIL=23:00
# GAIA_BRIEFING_EVENING_INSIGHT=true
# Carteira no briefing (seg/qua/sex):
# GAIA_BRIEFING_MARKET_ENABLED=true
# GAIA_BRIEFING_MARKET_AT=12:00
# GAIA_BRIEFING_MARKET_UNTIL=18:00

# --- Iniciativa (proatividade) ---
# GAIA_PROACTIVE_ENABLED=true
# GAIA_PROACTIVE_STARTUP_GREETING=true
# GAIA_PROACTIVE_GREETING_VIA_LLM=false
# GAIA_PROACTIVE_IDLE_CHECKIN=true
# GAIA_PROACTIVE_IDLE_MINUTES=45
# GAIA_PROACTIVE_MIN_INTERVAL_MINUTES=60
# GAIA_PROACTIVE_DAILY_MAX=4
# GAIA_PROACTIVE_QUIET_HOURS=23:00-08:00
# GAIA_PROACTIVE_CHECK_INTERVAL_SECONDS=30
# GAIA_PROACTIVE_REMINDERS=true

# --- Rotina de vagas (career) ---
# GAIA_CAREER_ENABLED=true
# GAIA_CAREER_AT=09:00
# GAIA_CAREER_UNTIL=18:00
# GAIA_CAREER_MAX_ITEMS=8
# GAIA_CAREER_STATE_FILE=       # vazio = <data_dir>/career/state.json

# --- WhatsApp Cloud API (Meta) ---
# Crie um app em developers.facebook.com, adicione o produto WhatsApp e
# use o Phone Number ID + token de acesso. Segredos apenas aqui no .env.
# GAIA_WHATSAPP_ENABLED=true
# GAIA_WHATSAPP_PHONE_NUMBER_ID=
# GAIA_WHATSAPP_ACCESS_TOKEN=
# Token que VOCE define e informa tambem no painel da Meta (webhook).
# GAIA_WHATSAPP_VERIFY_TOKEN=
# Numero que recebe as mensagens da Gaia (formato internacional, so digitos).
# GAIA_WHATSAPP_RECIPIENT=5584999999999
# GAIA_WHATSAPP_API_VERSION=v21.0
# GAIA_WHATSAPP_WEBHOOK_HOST=127.0.0.1
# GAIA_WHATSAPP_WEBHOOK_PORT=8765

# --- Telegram Bot API ---
# Crie um bot com @BotFather (/newbot) e cole o token aqui.
# GAIA_TELEGRAM_ENABLED=true
# GAIA_TELEGRAM_BOT_TOKEN=
# Vazio => usa o primeiro chat que falar com o bot.
# GAIA_TELEGRAM_ALLOWED_CHAT_ID=
# GAIA_TELEGRAM_POLL_TIMEOUT=25
# Responder também com áudio (mp3):
# GAIA_TELEGRAM_VOICE_REPLIES=false
# Aprovar no chat as ferramentas que pedem confirmação — inclusive agenda_*
# (o Telegram não tem terminal para pedir permissão; exige
# GAIA_TELEGRAM_ALLOWED_CHAT_ID fixado):
# GAIA_TELEGRAM_AUTO_APPROVE=false
# Liberar bash/write/edit no chat. Desligado (padrão) o bot alcança a Agenda
# pelas ferramentas agenda_* e não roda comando na máquina:
# GAIA_TELEGRAM_SHELL_ACCESS=false
# Mostrar o raciocinio no chat (interruptor proprio, separado da TUI):
# GAIA_TELEGRAM_SHOW_REASONING=false

# --- Navegador (Playwright) ---
# GAIA_BROWSER_ENABLED=true
# GAIA_BROWSER_PROFILE_DIR=~/.local/share/gaia/browser
# GAIA_BROWSER_HEADLESS=true
# GAIA_BROWSER_TIMEOUT_MS=30000

# --- pi (harness de codigo, ferramenta `pi`) ---
# Desligado por padrao. Ligado, o agente delega tarefas de codigo ao pi num
# clone separado do repo do deploy (~/gaia e resetado pelo timer de 5 min).
# O pi autentica pelo ambiente: GH_TOKEN (gh/git), DEEPSEEK_API_KEY etc.
# GAIA_PI_ENABLED=false
# GAIA_PI_BINARY=                   # vazio => pi do PATH ou ~/.pi/agent/bin/pi
# GAIA_PI_WORKSPACE=~/pr-workspace
# GAIA_PI_MODEL=commandcode/deepseek/deepseek-v4.1-flash

# --- Agenda (Supabase) ---
# Leitura das tarefas do dia para avisos proativos.
# GAIA_AGENDA_ENABLED=true
# GAIA_AGENDA_ENV_FILE=~/agenda-git/agenda/.env
# GAIA_AGENDA_POLL_MINUTES=30
# GAIA_AGENDA_MAX_ITEMS=5
# 0 = nao checa a pagina de tarefas sozinho (so no /tarefas sync):
# GAIA_AGENDA_TASKS_POLL_SECONDS=0
# GAIA_AGENDA_NOTIFY_PENDING=false

# --- Estudos (Abin Suite / Supabase) ---
# Progresso dos simulados do Abin Suite. O Abin usa um projeto Supabase
# proprio (separado da Agenda): aponte GAIA_ESTUDOS_ENV_FILE para o .env dele.
# GAIA_ESTUDOS_ENABLED=true
# GAIA_ESTUDOS_ENV_FILE=~/abin-suite/.env
# GAIA_ESTUDOS_POLL_MINUTES=60
# Cobrar quando nao estudou e a meta esta atrasada (uma vez por dia):
# GAIA_ESTUDOS_REMIND_WHEN_LATE=true
# GAIA_ESTUDOS_REMIND_AT=20:00
# Dias de estudo (0=seg..6=dom), so no TOML: study_days = [6, 2, 4, 5]
# GAIA_ESTUDOS_MAX_ITEMS=5
#
# Conteudo do .env apontado acima (nunca versione):
#   VITE_SUPABASE_URL=https://SEU-PROJETO-ABIN.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY=...   # service_role do projeto do Abin (fura RLS)
#   ESTUDOS_USER_ID=...             # uuid da conta Google no Abin

# --- Foco e lua ---
# GAIA_FOCUS_ENABLED=true
# GAIA_FOCUS_PATH=~/.config/gaia/focus.json
# GAIA_FOCUS_PROMPT_ON_MOON=true

# --- Servidor (gaia serve) ---
# Um processo dono do banco, do Second Brain, dos workers e do Telegram;
# as telas usam `gaia --remote URL` ou a web em GET /.
# Escutar fora do loopback exige GAIA_SERVE_TOKEN.
# GAIA_SERVE_ENABLED=false
# GAIA_SERVE_HOST=127.0.0.1
# GAIA_SERVE_PORT=8787
# GAIA_SERVE_TOKEN=
# GAIA_SERVE_ALLOW_REMOTE=false
# GAIA_SERVE_TELEGRAM=true      # sobe o poller do Telegram junto
# Id desta maquina em <data_dir>/instances.json (seletor de instancia no web).
# Vazio = a instancia "atual" e marcada pelo endereco aberto no navegador.
# GAIA_SERVE_INSTANCE_ID=mini
# De onde vem o audio do modo voz do web: "browser" (o navegador grava e envia
# WAV para /voice/upload) ou "server" (o proprio motor grava, /voice/listen).
# Padrao browser: mini headless normalmente nao tem microfone util.
# GAIA_SERVE_VOICE_SOURCE=browser

# --- Control Center (painel em /control) ---
# Segredo SEPARADO do token do chat: o painel grava credenciais e edita a
# configuracao, entao o token de conversa nao pode administrar. Se ficar vazio,
# /control mostra instrucao e /control/api nao existe (503).
# Gere com: python -c "import secrets;print(secrets.token_urlsafe(32))"
# O painel troca esse valor por uma sessao (cookie HttpOnly) em
# POST /control/api/session; o token so e digitado uma vez por navegador.
# GAIA_CONTROL_TOKEN=

# --- Dados locais ---
# GAIA_DATA_DIR=~/.local/share/gaia
# GAIA_CONFIG=~/.config/gaia/config.toml
